{
  "name": "lunarweb-project",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "drizzle-orm": "^0.45.2",
      "@types/bun": "^1.4.1",
      "@orpc/client": "^1.15.0",
      "@orpc/server": "^1.15.0",
      "elysia": "^1.4.30",
      "zod": "^4.5.4"
    }
  },
  "scripts": {
    "check": "biome check --write .",
    "dev": "turbo dev --concurrency=20",
    "build": "turbo build",
    "build:packages": "turbo build --filter=\"@lunarweb/*\"",
    "check:types": "turbo check:types",
    "check:lint": "turbo check:lint",
    "db:push": "turbo -F @lunarweb/database db:push",
    "db:studio": "turbo -F @lunarweb/database db:studio",
    "db:generate": "turbo -F @lunarweb/database db:generate",
    "db:migrate": "turbo -F @lunarweb/database db:migrate",
    "tg:webhook": "turbo -F @lunarweb/telegram tg:webhook",
    "test": "bun run --cwd apps/server test",
    "test:ci": "bun run --cwd apps/server test:ci"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "turbo": "^2.8.8"
  },
  "packageManager": "bun@1.4.2"
}
