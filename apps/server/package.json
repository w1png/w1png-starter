{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsc --emitDeclarationOnly && bun build --target=bun --minify ./src/index.ts --outdir dist",
		"check:types": "tsc --noEmit && tsc -p tsconfig.tests.json",
		"check:lint": "biome check",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun dist/index.js",
		"test": "vitest run",
		"test:ci": "vitest run --reporter=dot --reporter=junit --outputFile.junit=test-results/junit.xml",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@lunarweb/database": "workspace:*",
		"@lunarweb/files": "workspace:*",
		"@lunarweb/logger": "workspace:*",
		"@lunarweb/redis": "workspace:*",
		"@lunarweb/shared": "workspace:*",
		"@orpc/server": "catalog:",
		"better-auth": "^1.7.3",
		"dotenv": "^17.3.1",
		"drizzle-orm": "catalog:",
		"elysia": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "^5.9.3",
		"vitest": "^5.0.0",
		"testcontainers": "^12.1.0",
		"@testcontainers/postgresql": "^12.1.0",
		"@testcontainers/redis": "^12.1.0"
	}
}
